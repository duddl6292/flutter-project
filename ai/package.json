{
  "name": "brainon-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --import tsx src/http/server.ts",
    "dev:mcp": "node --env-file-if-exists=../.env --import tsx src/mcp/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@genkit-ai/google-genai": "1.40.1",
    "@genkit-ai/mcp": "1.40.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "genkit": "1.40.1"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}

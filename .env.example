# Application
APP_ENV=development

# PostgreSQL (local example values only)
POSTGRES_DB=brainon
POSTGRES_USER=brainon
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Django placeholders
DJANGO_SECRET_KEY=replace-with-a-local-development-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Authentication
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
JWT_REFRESH_COOKIE_NAME=brainon_refresh

# Service URLs
BACKEND_URL=http://localhost:8000
INFERENCE_URL=http://localhost:8100
FRONTEND_URL=http://localhost:5173

# React
VITE_API_BASE_URL=http://localhost:8000

# Inference local ports
INFERENCE_GATEWAY_PORT=8100
MOSEC_HOST_PORT=8001
GATEWAY_MOSEC_TIMEOUT_SECONDS=300

# CT analysis (Django -> GCS -> private Cloud Run Gateway)
CT_INPUT_BUCKET=brainon_ct-input_patient
CT_INPUT_PREFIX=uploads
CT_DATASET_MANIFEST_URI=gs://brainon_ct-input_patient/manifests/brainon_ct_verified_manifest_20260805.csv
# 로컬 ADC의 API 과금/할당 프로젝트. Cloud Run에서는 서비스 프로젝트가 자동 적용됩니다.
GOOGLE_CLOUD_QUOTA_PROJECT=project-77d13b0f-3be4-4791-a87
CT_INFERENCE_GATEWAY_URL=https://brainon-gateway-3gykqo24da-as.a.run.app
CT_INFERENCE_GATEWAY_AUDIENCE=https://brainon-gateway-3gykqo24da-as.a.run.app
# 로컬 개발에서만 true. Cloud Run 배포 환경에서는 반드시 false.
CT_GATEWAY_USE_GCLOUD_AUTH=false
CT_MODEL_VERSION=1.0.0
CT_GATEWAY_TIMEOUT_SECONDS=920
CT_MAX_UPLOAD_BYTES=536870912

# Firebase Admin (server-side only; never use the Flutter client config here)
FCM_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
FCM_HTTP_TIMEOUT_SECONDS=10

# Firebase Web (public client configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=

# Genkit / Vertex AI (local: gcloud ADC, Cloud Run: service account)
GOOGLE_CLOUD_PROJECT=project-77d13b0f-3be4-4791-a87
GOOGLE_CLOUD_LOCATION=global
AI_MODEL=gemini-2.5-flash
AI_SERVICE_URL=http://localhost:18200
AI_SERVICE_PORT=18200

# MCP
MCP_SERVER_URL=http://localhost:18201
MCP_SERVER_PORT=18201

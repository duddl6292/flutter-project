# Application
APP_ENV=development

# PostgreSQL (local example values only)
POSTGRES_DB=brainon
POSTGRES_USER=brainon
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Django placeholders
DJANGO_SECRET_KEY=replace-with-a-local-development-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Authentication
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
JWT_REFRESH_COOKIE_NAME=brainon_refresh
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7
DATABASE_URL=postgresql://brainon:brainon@postgres:5432/brainon
TIME_ZONE=Asia/Seoul

# Service URLs
BACKEND_URL=http://localhost:8000
INFERENCE_URL=http://localhost:8100
INFERENCE_BASE_URL=http://inference-mock:8100
INFERENCE_INTERNAL_API_KEY=change-me
INFERENCE_CONNECT_TIMEOUT_SECONDS=5
INFERENCE_READ_TIMEOUT_SECONDS=60
INFERENCE_USE_MOCK=True
STORAGE_BACKEND=mock
GCS_BUCKET_MEDICAL_DATA=
GCS_BUCKET_RESULTS=
SIGNED_URL_EXPIRES_SECONDS=900
FCM_BACKEND=mock
FRONTEND_URL=http://localhost:5173

# React
VITE_API_BASE_URL=http://localhost:8000

# Inference local ports
INFERENCE_GATEWAY_PORT=8100
MOSEC_HOST_PORT=8001
GATEWAY_MOSEC_TIMEOUT_SECONDS=300

# Firebase Admin (server-side only; never use the Flutter client config here)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# Genkit / Gemini
GEMINI_API_KEY=
AI_SERVICE_URL=http://localhost:8200
AI_SERVICE_PORT=8200

# MCP
MCP_SERVER_URL=http://localhost:8201
MCP_SERVER_PORT=8201

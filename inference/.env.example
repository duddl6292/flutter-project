# BrainOn inference example values. Do not put credentials in this file.
GOOGLE_CLOUD_PROJECT=replace-with-gcp-project-id

MOSEC_ADDRESS=0.0.0.0
MOSEC_PORT=8000
MOSEC_TIMEOUT_MS=300000

MODEL_BUCKET=
MODEL_OBJECT=
MODEL_SHA256=
MODEL_ID=brainon-bhsd-nnunet-25d
MODEL_VERSION=bhsd-nnunet-v1.0.0
MODEL_FOLDS=0
MODEL_CHECKPOINT=checkpoint_best.pth
MODEL_DEVICE=cuda

RESULTS_URI_PREFIX=gs://replace-with-results-bucket/results
REQUEST_WORK_ROOT=/tmp/brainon-inference
MODEL_CACHE_DIR=/models
MODEL_LOAD_ON_STARTUP=true
ALLOW_LOCAL_FILES=false
